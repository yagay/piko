<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose 画出第一帧之前，窗口背景由这里决定。框架的 Theme.Material 是深色主题，
      浅色模式下冷启动会先闪一屏黑。背景色与 Compose 主题的 background 取同一值。
    -->
    <style name="Theme.Piko" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/piko_window_background</item>
    </style>
    <!-- Small separate task window, preserving the caller behind a dimmed dialog. -->
    <style name="Theme.Piko.ExternalMagnet" parent="Theme.Piko">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
</resources>
